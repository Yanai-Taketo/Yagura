@page "/admin"
@namespace Yagura.Web.Administration.Screens
@layout AdminScreenLayout
@using Yagura.Abstractions.Administration
@inject IConfigurationReloadService ReloadService
@inject IEmailNotificationAdminService EmailNotificationAdminService
@inject Yagura.Web.Administration.ViewerHttpsRuntimeState ViewerHttpsState
@inject Yagura.Web.Administration.StorageAvailabilityState StorageAvailability
@inject IOldDatabaseDisposalService OldDatabaseDisposal

@*
    設定トップ（ui.md §4 の画面構成「設定（ウィザード群）」の入口。M8-4 骨格）。
    管理リスナ帰属・ガードは AdminScreenLayout が担う。

    再起動待ちの設定変更の常設カード: 設定の
    再読み込み（CF-4 層1）が累積追跡する「反映にサービス再起動が要るキー」を、再読み込み
    操作の時点だけでなく管理面の入口に常設表示する。表示先は認証済み管理面のみ——閲覧面
    （/status 等）には出さない（管理系情報を閲覧面に露出しない）。プロセス内状態の
    ため再起動で自然に消える。

    以前の保存先（組み込みデータベース）のファイルの後始末が残っている常設カード（database.md §6.3 の
    状態表・ui.md §4）: 判定は旧ファイルを開かない状態の取得による。状態を変える操作はカードに置かず、
    昇格ページの後始末セクションへの導線だけを置く。後始末が済めば自然に消える。
*@
<PageTitle>@UiText.AdminHomeTitle - Yagura</PageTitle>

<MudText Typo="Typo.h5">@UiText.AdminHomeTitle</MudText>

@if (_pendingRestartKeys.Count > 0)
{
    <MudAlert Severity="Severity.Warning" Class="mt-4">
        <MudText Typo="Typo.subtitle1"><b>@UiText.AdminPendingRestartCardTitle</b></MudText>
        <MudText Typo="Typo.body2">@UiText.AdminPendingRestartCardDescription</MudText>
        <ul class="mt-2">
            @foreach (var entry in _pendingRestartKeys)
            {
                <li>
                    <code>@entry.Key</code>
                    <MudText Typo="Typo.caption" Class="ml-2 d-inline">
                        @UiText.AdminPendingRestartDetectedAtLabel<YaguraTimestamp Value="entry.DetectedAt" />
                    </MudText>
                </li>
            }
        </ul>
    </MudAlert>
}

@if (_disposalStatus is { } disposal && OldDatabaseDisposalIncomplete(disposal))
{
    <MudAlert Severity="@(OldDatabaseDisposalRunning(disposal) ? Severity.Info : Severity.Warning)" Class="mt-4">
        <MudText Typo="Typo.subtitle1"><b>@UiText.AdminOldDatabaseDisposalCardTitle</b></MudText>
        <MudText Typo="Typo.body2">@UiText.AdminOldDatabaseDisposalCardDescription</MudText>
        @if (disposal.TargetFiles.Count > 0)
        {
            <MudText Typo="Typo.body2">
                @string.Format(UiText.AdminOldDatabaseDisposalCardFilesFormat, disposal.TargetFiles.Count, YaguraByteFormatter.Format(disposal.TotalSizeBytes))
            </MudText>
        }
        @if (OldDatabaseDisposalStateText(disposal) is { } stateText)
        {
            <MudText Typo="Typo.body2" Class="mt-1">@stateText</MudText>
        }
        @if (disposal.MisplacedRecordedOldDatabasePath is { } misplaced)
        {
            <MudText Typo="Typo.body2" Class="mt-1">@string.Format(UiText.OldDatabaseDisposalMisplacedFormat, misplaced)</MudText>
        }
        <MudLink Href="/admin/promotion" Typo="Typo.body2" Class="mt-1 d-inline-block">@UiText.AdminOldDatabaseDisposalCardLink</MudLink>
    </MudAlert>
}

@* メール通知チャネルの健全性カード(ADR-0017 決定 5): 設定画面ではなく
   「日常動線」である管理面入口に常設する(再起動待ちカードと同じ置き場)。機能を
   有効にしている(有効にしたつもりを含む)間だけ表示し、未使用の環境にはノイズを出さない。 *@
@if (_emailStatus is { Enabled: true } emailStatus)
{
    <MudAlert Severity="@EmailHealthSeverity(emailStatus)" Class="mt-4">
        <MudText Typo="Typo.subtitle1"><b>@UiText.AdminEmailHealthCardTitle</b></MudText>
        @if (emailStatus.Health.DisabledByInvalidConfiguration)
        {
            <MudText Typo="Typo.body2">@UiText.EmailNotificationDisabledByInvalidConfiguration</MudText>
        }
        <MudText Typo="Typo.body2">
            @UiText.EmailNotificationHealthLastSuccess: @FormatTimestamp(emailStatus.Health.LastSuccessAt) ／
            @UiText.EmailNotificationHealthLastFailure: @(emailStatus.Health.LastFailureKind ?? UiText.EmailNotificationHealthNever) ／
            @UiText.EmailNotificationHealthDropped: @string.Format(UiText.EmailNotificationHealthCountFormat, emailStatus.Health.DroppedCount) ／
            @UiText.EmailNotificationHealthSuppressed: @string.Format(UiText.EmailNotificationHealthCountFormat, emailStatus.Health.SuppressedCount)
        </MudText>
        <MudText Typo="Typo.caption" Class="mt-1 d-block">@UiText.AdminEmailHealthCardDescription</MudText>
        <MudLink Href="/admin/email-notification" Typo="Typo.caption">@UiText.AdminEmailHealthCardDetailLink</MudLink>
    </MudAlert>
}

@if (ViewerHttpsState.ListenerSuppressed)
{
    @* 閲覧リスナの縮小継続の常設バナー（ADR-0022 決定 2 可視化③）:
       メール通知未設定の環境では「RDP して管理画面を開いた瞬間に分かる」ことが現実的な発見経路
       である。管理ホームを開くたびに必ず目に入る位置に置く。 *@
    <MudAlert Severity="Severity.Warning" Class="mt-4">
        @string.Format(UiText.AdminHomeViewerHttpsSuppressedFormat, ViewerHttpsState.Reason)
        <MudLink Href="/admin/viewer-https">@UiText.ViewerHttpsTitle</MudLink>
    </MudAlert>
}

@if (!_storageAvailable)
{
    @* 保存先到達不能による縮退の常設バナー（ADR-0023 決定 1）: 起動を失敗させずに
       縮退させる以上、**縮退していることが必ず見える**のが成立条件（「可視化された縮退」）。
       Windows 認証や認証無効の環境では管理面に入れてしまうため、入れた側にも同じ事実を見せる。
       失敗の詳細（保存先名・例外文字列）はここには出さない——出所はイベントログに寄せる。 *@
    <MudAlert Severity="Severity.Error" Class="mt-4">
        <MudText Typo="Typo.subtitle1"><b>@UiText.AdminHomeStorageUnavailableTitle</b></MudText>
        <MudText Typo="Typo.body2">@UiText.AdminHomeStorageUnavailableDescription</MudText>
    </MudAlert>
}

<MudPaper Elevation="1" Class="pa-4 mt-4">
    <MudNavMenu>
        <MudNavLink Href="/admin/setup">@UiText.AdminSetupWizardTitle</MudNavLink>
        <MudNavLink Href="/admin/promotion">@UiText.AdminPromotionWizardTitle</MudNavLink>
        <MudNavLink Href="/admin/circuits">@UiText.AdminCircuitsTitle</MudNavLink>
        <MudNavLink Href="/admin/forwarder-kit">@UiText.ForwarderKitTitle</MudNavLink>
        <MudNavLink Href="/admin/auth-setup">@UiText.AdminAuthSetupTitle</MudNavLink>
        <MudNavLink Href="/admin/remote-access">@UiText.AdminRemoteAccessTitle</MudNavLink>
        <MudNavLink Href="/admin/ingestion-tls">@UiText.IngestionTlsTitle</MudNavLink>
        <MudNavLink Href="/admin/viewer-https">@UiText.ViewerHttpsTitle</MudNavLink>
        <MudNavLink Href="/admin/email-notification">@UiText.EmailNotificationTitle</MudNavLink>
        <MudNavLink Href="/admin/source-silence">@UiText.SourceSilenceTitle</MudNavLink>
    </MudNavMenu>
</MudPaper>

@code {
    private IReadOnlyList<PendingRestartKey> _pendingRestartKeys = [];
    private EmailNotificationStatus? _emailStatus;
    private bool _storageAvailable = true;
    private OldDatabaseDisposalStatus? _disposalStatus;

    protected override async Task OnInitializedAsync()
    {
        // スナップショット読み取りのみ（再読み込みは実行しない——状態を変更しない読み取り口）。
        _pendingRestartKeys = ReloadService.GetPendingRestartKeys();
        _storageAvailable = StorageAvailability.IsAdminAccountStoreAvailable;
        _emailStatus = await EmailNotificationAdminService.GetStatusAsync();
        _disposalStatus = await OldDatabaseDisposal.GetStatusAsync();
    }

    /// <summary>
    /// 未完了: 状態表の「対象外」以外、または切り替えの時点のファイルが別の名前で残っている（能動通知 1041 と同じ判定）。
    /// </summary>
    private static bool OldDatabaseDisposalIncomplete(OldDatabaseDisposalStatus status) =>
        status.State != OldDatabaseDisposalState.NotApplicable || status.MisplacedRecordedOldDatabasePath is not null;

    private static bool OldDatabaseDisposalRunning(OldDatabaseDisposalStatus status) =>
        status.State is OldDatabaseDisposalState.MigrationRunning
            or OldDatabaseDisposalState.DisposalRunning
            or OldDatabaseDisposalState.DisposalDeleting;

    private static string? OldDatabaseDisposalStateText(OldDatabaseDisposalStatus status) => status.State switch
    {
        OldDatabaseDisposalState.MigrationRunning => UiText.OldDatabaseDisposalMigrationRunning,
        OldDatabaseDisposalState.DisposalRunning or OldDatabaseDisposalState.DisposalDeleting => UiText.AdminOldDatabaseDisposalCardRunning,
        OldDatabaseDisposalState.LastAttemptFailed when status.LastResult is { } failed =>
            string.Format(UiText.AdminOldDatabaseDisposalCardLastFailedFormat, failed.Message),
        _ => null,
    };

    /// <summary>
    /// カードの色: 「有効にしたつもりで送られていない」（設定不正で無効化）と直近の失敗ありは
    /// 警告、それ以外は情報（常設表示の既定）。
    /// </summary>
    private static MudBlazor.Severity EmailHealthSeverity(EmailNotificationStatus status) =>
        status.Health.DisabledByInvalidConfiguration || status.Health.LastFailureKind is not null
            ? MudBlazor.Severity.Warning
            : MudBlazor.Severity.Info;

    private static string FormatTimestamp(DateTimeOffset? value) =>
        value is null ? UiText.EmailNotificationHealthNever : YaguraTimeFormatter.FormatLocal(value.Value);
}
